# Copy to apps/backend/.env
#
#   Copy-Item apps/backend/.env.example apps/backend/.env
#
# This file, NOT the repository-root .env, is what the backend reads.
# src/config/env.ts calls `import 'dotenv/config'`, which resolves
# path.resolve(process.cwd(), '.env'), and `pnpm dev:backend` runs with
# apps/backend as the working directory. The root .env is read by Docker
# Compose only.
#
# Every value below has a working default in src/config/env.ts, so the backend
# starts with no .env at all. Copy this only when you need to change something.

# ---- runtime -------------------------------------------------------------
NODE_ENV=development     # development | test | production
PORT=4000                # port the Express + Socket.io server binds
HOST=0.0.0.0             # bind all interfaces so phones can reach this laptop
                         # over the LAN; 127.0.0.1 restricts it to this machine
API_PREFIX=/api/v1       # global prefix for every REST route

# Comma-separated browser origins allowed by CORS. The mobile apps send no
# Origin header and are unaffected; this is for the admin portal and Metro.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8081,http://localhost:8082

# `quiet` silences the live dispatch console. The test suite sets this.
DISPATCH_LOG=pretty      # pretty | quiet

# ---- demo scripts --------------------------------------------------------
# Where pnpm demo:reset / demo:request / demo:walk send their requests. Only
# change this to drive a backend that is not on this machine.
API_URL=http://localhost:4000

# ---- optional ------------------------------------------------------------
# The fare engine's weather term is a fixed demo value (Weather.RAIN) so a
# surge multiplier cannot change mid-judging. The live OpenWeather provider is
# written but commented out in src/pricing/weather.ts; it needs a key from
# https://openweathermap.org/api and a network the venue may not have.
OPENWEATHER_API_KEY=

# ---- not yet wired -------------------------------------------------------
# Declared so there is one place to look when these land. NOTHING reads them
# today: the backend runs on a deterministic in-memory store, and the values
# below are left blank on purpose so a half-configured service cannot appear
# to work. See the roadmap in README.md.
#
# Start the containers these point at with `docker compose up -d`, configured
# from the repository-root .env.
DATABASE_URL=              # postgresql://sahayo:sahayo@localhost:5432/sahayo
REDIS_URL=                 # redis://localhost:6379

JWT_SECRET=                # signing secret for access tokens; generate per environment
JWT_EXPIRES_IN=7d          # access token lifetime
OTP_PROVIDER_API_KEY=      # SMS gateway key for phone login
OTP_PROVIDER_SENDER_ID=    # registered sender id for OTP messages

PAYMENT_GATEWAY_KEY_ID=    # Razorpay/UPI gateway key id
PAYMENT_GATEWAY_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=    # verifies settlement webhook signatures

# NOTE: the broadcast radius and the offer timeout are NOT environment
# variables. They are packages/shared/src/constants.ts values, adjustable at
# runtime from the admin portal's Settings page, because a cooperative changing
# its own dispatch rules should not require a redeploy.
