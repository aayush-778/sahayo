{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": ["node"],
    // No rootDir: we consume @sahakar/shared as TypeScript source from outside
    // this directory, and rootDir is meaningless under noEmit anyway.
    "paths": {
      "@sahakar/shared": ["../../packages/shared/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts"]
}
