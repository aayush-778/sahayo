# Copy to apps/worker/.env. Gitignored; this template is not.
#
# EXPO_PUBLIC_* is inlined into the JS bundle at build time, so after changing
# anything here Metro must be restarted with a cleared cache:
#
#   pnpm --filter @sahayo/worker exec expo start --port 8082 -c

# Backend ORIGIN only. Do NOT append /api/v1 — src/realtime/config.ts adds the
# prefix itself, and the same origin is what the Socket.io client connects to.
#
#   USB demo (pnpm demo:tunnel) ... leave unset; the default localhost:4000 is
#                                   reversed onto the laptop by adb.
#   same-wifi demo .............. the LAN address the backend prints at startup,
#                                   e.g. http://192.168.1.20:4000
EXPO_PUBLIC_API_URL=http://localhost:4000

# Report location as Rajendra Nagar, Patna plus however far the phone has moved
# since its first fix, so a demo given anywhere still lands on Patna's dispatch
# map. Movement, permission and throttling stay real. Set to `off` for raw GPS.
EXPO_PUBLIC_DEMO_ANCHOR=on
