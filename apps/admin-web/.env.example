# Copy to apps/admin-web/.env.local. Gitignored; this template is not.

# Backend REST base url, prefix included. The portal falls back to its
# deterministic in-memory dataset when this is unreachable, and the header pill
# reads "Demo data" instead of "Live".
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Names the offline service-worker cache. Defaults to the build timestamp in
# next.config.ts; set it to a release tag if you want a stable cache name.
# NEXT_PUBLIC_BUILD_VERSION=

# Redirects build output away from .next, so a verification build cannot corrupt
# a dev server that is already running. Not a normal setting — see CLAUDE.md.
# NEXT_DIST_DIR=.next-verify
