# Repository-root environment — read by Docker Compose ONLY.
#
#   Copy-Item .env.example .env
#
# Docker Compose reads the .env sitting next to docker-compose.yml, and every
# value below feeds a ${VAR:-default} substitution in that file. Nothing else
# in the repository reads this file.
#
# The application env templates live next to the app that loads them, because
# that is where each toolchain looks:
#
#   apps/backend/.env.example     -> apps/backend/.env       (dotenv, cwd-relative)
#   apps/admin-web/.env.example   -> apps/admin-web/.env.local (Next.js, app dir)
#   apps/customer/.env.example    -> apps/customer/.env      (Expo/Metro, app dir)
#   apps/worker/.env.example      -> apps/worker/.env        (Expo/Metro, app dir)
#
# Docker is optional. The prototype's backend runs on a deterministic
# in-memory store and needs neither Postgres nor Redis; both are provisioned
# ahead of the persistence work. See the roadmap in README.md.

# ---- postgres / postgis --------------------------------------------------
# Local container credentials. Not secrets: the container is bound to
# localhost and holds nothing but seeded demo data. Change them for any
# deployment that is not a laptop.
POSTGRES_USER=sahayo
POSTGRES_PASSWORD=sahayo
POSTGRES_DB=sahayo
POSTGRES_PORT=5432        # host port mapped to the container's 5432

# ---- redis ---------------------------------------------------------------
REDIS_PORT=6379           # host port mapped to the container's 6379
