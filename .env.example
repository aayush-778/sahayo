# Copy to .env and fill in. Everything here is safe to commit — real values
# belong in .env, which is gitignored.
#
# Only the "runtime" and "demo scripts" blocks are read today
# (apps/backend/src/config/env.ts). The rest are declared so later phases have
# one place to look.

# ---- runtime -------------------------------------------------------------
NODE_ENV=development                  # development | test | production
PORT=4000                             # port the Express + Socket.io server binds
HOST=0.0.0.0                          # bind all interfaces so phones reach it over the LAN
API_PREFIX=/api/v1                    # global prefix for every REST route
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8081,http://localhost:8082
DISPATCH_LOG=pretty                   # pretty | quiet — `quiet` silences the dispatch console

# ---- demo scripts --------------------------------------------------------
# Read by apps/backend/scripts/demo-*.ts when driving a non-local backend.
API_URL=http://localhost:4000

# ---- postgres / postgis (not yet wired) ----------------------------------
POSTGRES_USER=sahayo                 # docker-compose postgres superuser
POSTGRES_PASSWORD=sahayo             # docker-compose postgres password
POSTGRES_DB=sahayo                   # docker-compose database name
POSTGRES_PORT=5432                    # host port mapped to the postgres container
DATABASE_URL=postgresql://sahayo:sahayo@localhost:5432/sahayo

# ---- redis (not yet wired) -----------------------------------------------
REDIS_PORT=6379                       # host port mapped to the redis container
REDIS_URL=redis://localhost:6379      # gig offer locks, socket adapter, rate limits

# ---- auth (not yet wired) ------------------------------------------------
JWT_SECRET=change-me                  # signing secret for access tokens
JWT_EXPIRES_IN=7d                     # access token lifetime
OTP_PROVIDER_API_KEY=                 # SMS/OTP gateway key for phone login
OTP_PROVIDER_SENDER_ID=               # registered sender id for OTP messages

# ---- dispatch tuning -----------------------------------------------------
# Defaults live in packages/shared/src/constants.ts and are adjustable at
# runtime from the admin portal's Settings page.
DEFAULT_RADIUS_M=5000                 # broadcast radius when matching workers
GIG_OFFER_TIMEOUT_MS=30000            # how long a worker has to accept an offer

# ---- payments / settlement (not yet wired) -------------------------------
PAYMENT_GATEWAY_KEY_ID=               # Razorpay/UPI gateway key id
PAYMENT_GATEWAY_KEY_SECRET=           # Razorpay/UPI gateway secret
PAYMENT_WEBHOOK_SECRET=               # verifies settlement webhook signatures

# ---- maps / weather ------------------------------------------------------
# The street maps use OpenStreetMap raster tiles and need no key at all.
# The fare engine's weather term is a fixed demo value; the live OpenWeather
# provider in apps/backend/src/pricing/weather.ts is commented out.
OPENWEATHER_API_KEY=                  # only needed if that provider is enabled

# ---- client-side (must stay public-safe, these ship in the bundle) -------
# admin-web: see apps/admin-web/.env.example
# customer / worker: see apps/customer/.env.example and apps/worker/.env.example
