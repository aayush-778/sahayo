# Copy to .env and fill in. Nothing outside apps/backend/src/config/env.ts is
# read yet — the rest are declared here so later phases have one place to look.

# ---- runtime -------------------------------------------------------------
NODE_ENV=development                  # development | test | production
PORT=4000                             # port the Express + Socket.io server binds
API_PREFIX=/api/v1                    # global prefix for every REST route
CORS_ORIGINS=http://localhost:3000,http://localhost:8081  # comma-separated allowed browser origins

# ---- postgres / postgis (Phase 5) ---------------------------------------
POSTGRES_USER=sahakar                 # docker-compose postgres superuser
POSTGRES_PASSWORD=sahakar             # docker-compose postgres password
POSTGRES_DB=sahakar                   # docker-compose database name
POSTGRES_PORT=5432                    # host port mapped to the postgres container
DATABASE_URL=postgresql://sahakar:sahakar@localhost:5432/sahakar  # connection string used by the backend

# ---- redis (Phase 5) -----------------------------------------------------
REDIS_PORT=6379                       # host port mapped to the redis container
REDIS_URL=redis://localhost:6379      # gig offer locks, socket adapter, rate limits

# ---- auth ----------------------------------------------------------------
JWT_SECRET=change-me                  # signing secret for access tokens
JWT_EXPIRES_IN=7d                     # access token lifetime
OTP_PROVIDER_API_KEY=                 # SMS/OTP gateway key for phone login
OTP_PROVIDER_SENDER_ID=               # registered sender id for OTP messages

# ---- dispatch tuning -----------------------------------------------------
DEFAULT_RADIUS_M=5000                 # broadcast radius when matching workers
GIG_OFFER_TIMEOUT_MS=30000            # how long a worker has to accept an offer

# ---- payments / settlement ----------------------------------------------
PAYMENT_GATEWAY_KEY_ID=               # Razorpay/UPI gateway key id
PAYMENT_GATEWAY_KEY_SECRET=           # Razorpay/UPI gateway secret
PAYMENT_WEBHOOK_SECRET=               # verifies settlement webhook signatures

# ---- maps / geocoding ----------------------------------------------------
MAPS_API_KEY=                         # geocoding and route/ETA lookups

# ---- client-side (must stay public-safe) ---------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1    # admin-web REST base url
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1    # mobile REST base url
EXPO_PUBLIC_SOCKET_URL=http://localhost:4000        # mobile Socket.io endpoint
